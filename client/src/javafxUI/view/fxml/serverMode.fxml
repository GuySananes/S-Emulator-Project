<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="javafxUI.controller.ServerModeController"
      spacing="10" style="-fx-padding: 20;">

    <!-- Login Section -->
    <VBox spacing="10" style="-fx-border-color: #cccccc; -fx-border-width: 1; -fx-padding: 15;">
        <Label text="Server Mode - Connect to Remote API" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Username:"/>
            <TextField fx:id="usernameField" promptText="Enter username" prefWidth="200"/>
            <Button fx:id="loginButton" text="Login" onAction="#handleLogin"/>
        </HBox>

        <HBox spacing="20">
            <Label fx:id="statusLabel" text="Not logged in" style="-fx-text-fill: #666666;"/>
            <Label fx:id="creditsLabel" text="Credits: -" style="-fx-text-fill: #0066cc; -fx-font-weight: bold;"/>
        </HBox>
    </VBox>

    <!-- Users Table Section -->
    <VBox VBox.vgrow="ALWAYS" spacing="5">
        <Label text="Live Users (auto-refreshing)" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>

        <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="nameColumn" text="Name" prefWidth="120"/>
                <TableColumn fx:id="mainCountColumn" text="Mains" prefWidth="70"/>
                <TableColumn fx:id="funcCountColumn" text="Funcs" prefWidth="70"/>
                <TableColumn fx:id="creditsColumn" text="Credits" prefWidth="80"/>
                <TableColumn fx:id="usedColumn" text="Used" prefWidth="70"/>
                <TableColumn fx:id="runsColumn" text="Runs" prefWidth="70"/>
            </columns>
        </TableView>
    </VBox>
</VBox>